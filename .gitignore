# Impeccable: keep local runtime output out of version control.
**/.impeccable/*
!**/.impeccable/config.json
!**/.impeccable/design.json
!**/.impeccable/surfaces/
!**/.impeccable/critique/
!**/.impeccable/live/
**/.impeccable/live/*
!**/.impeccable/live/config.json

# Local emulator logs and the generated offline presentation bundle.
firebase-debug*.log
firestore-debug*.log
/VolunteerHub-demo.html
